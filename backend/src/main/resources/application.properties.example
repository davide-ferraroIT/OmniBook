spring.application.name=backend

# DataSource Configuration
# Update with your local database credentials if they differ from docker-compose defaults
spring.datasource.url=jdbc:postgresql://localhost:5432/omnibook
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:rootpassword}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA Configuration
# Set to 'validate' or 'none' in production
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Cloudinary Configuration (REQUIRED)
# Get these from your Cloudinary Dashboard. Do not commit actual secrets!
cloudinary.cloud-name=your_cloud_name
cloudinary.api-key=your_api_key
cloudinary.api-secret=your_api_secret
