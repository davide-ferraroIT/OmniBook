# Configurazione Database (lascia questi se usi docker-compose in locale)
DB_USERNAME=root
DB_PASSWORD=rootpassword

# Cloudinary - Recupera queste chiavi dalla tua dashboard Cloudinary
# NON inserire mai i tuoi segreti reali qui, copia questo file in un file chiamato ".env"
CLOUDINARY_CLOUD_NAME=il_tuo_cloud_name
CLOUDINARY_API_KEY=la_tua_api_key
CLOUDINARY_API_SECRET=il_tuo_api_secret

